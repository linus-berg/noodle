<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!-- Release builds pass /p:Version from the release tag. -->
        <Version>0.0.0-dev</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.1.2.1"/>
        <PackageReference Include="Polly.Core" Version="8.9.1"/>
        <PackageReference Include="Semver" Version="3.0.0"/>
        <PackageReference Include="System.IO.Hashing" Version="11.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Noodle.Tests"/>
    </ItemGroup>

</Project>
