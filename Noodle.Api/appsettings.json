{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Noodle.Requests": "Information"
    }
  },
  "AllowedHosts": "*",
  "Noodle": {
    "ApiKey": "",
    "PublicBaseUrl": "",
    "MaxTarballBytes": 2147483648,
    "MaxUnpackedBytes": 8589934592,
    "LogRequests": true,
    "PackumentCacheMegabytes": 512,
    "Sync": {
      "PollIntervalSeconds": 5,
      "SnapshotIntervalMinutes": 15,
      "DownloadFlushSeconds": 60,
      "ChangeRetentionHours": 24
    },
    "Ingest": {
      "BatchDelayMilliseconds": 500,
      "BusyWindowMilliseconds": 2000,
      "RecoverAfterSeconds": 60
    }
  },
  "Storage": {
    "ServiceUrl": "",
    "Bucket": "npm",
    "Prefix": "",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "ConditionalWrites": true,
    "CreateBucket": true
  }
}
