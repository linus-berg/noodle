{
  "name": "noodle-example",
  "version": "1.0.0",
  "private": true,
  "description": "A sample project whose few hundred dependencies come from a Noodle server.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "node --test"
  },
  "dependencies": {
    "JSONStream": "^1.3.5",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "express": "^5.1.0",
    "lodash": "^4.17.21",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "jest": "^29.7.0",
    "typescript": "^5.6.3"
  }
}
