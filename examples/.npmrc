# Points this project at the development server (started with "dotnet run"
# in Noodle.Api) instead of registry.npmjs.org. Copy it next to your own
# project to try that project against the server.
#
#   scripts/mirror-packages.sh      upload everything package-lock.json needs
#   cd examples
#   npm ci                          installs everything from the server
#   npm run build && npm start
#
# package-lock.json was created against registry.npmjs.org; npm rewrites its
# tarball URLs to this registry and checks the integrity of every download.
registry=http://localhost:5090/
# A cache of its own, so packages really come from the server and not from
# earlier installs (delete the folder to download everything again).
cache=.npm-cache
